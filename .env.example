# Kabmeet environment. Copy to .env and fill in. Never commit .env.

# Port the server listens on.
PORT=3000

# Public URL of the site, used for links and callbacks.
APP_URL=https://ai.kab.ac.ug

# First admin. Pick ONE of these:
# 1) ADMIN_PASSCODE: the password for admin@ai.kab.ac.ug (no setup screen needed).
# 2) Leave it empty: on first start the server prints a one-time setup code in the console.
#    Set ADMIN_SETUP_CODE to choose that code yourself instead of a random one.
ADMIN_PASSCODE=
ADMIN_SETUP_CODE=
