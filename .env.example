# Kabmeet environment. Copy to .env and fill in. Never commit .env.

# Port the server listens on.
PORT=3000

# Public URL of the site, used for links and callbacks.
APP_URL=https://ai.kab.ac.ug

# First admin. Pick ONE of these:
# 1) ADMIN_PASSCODE: the password for admin@ai.kab.ac.ug (no setup screen needed).
# 2) Leave it empty: on first start the server prints a one-time setup code in the console.
#    Set ADMIN_SETUP_CODE to choose that code yourself instead of a random one.
ADMIN_PASSCODE=
ADMIN_SETUP_CODE=

# Video (LiveKit, self-hosted). Leave all three empty to run without video:
# Rooms then say "Video is not configured on this server" and chat keeps working.
# LIVEKIT_URL is the address BROWSERS use (wss://video.example.ac.ug in production).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional: address the Kabmeet SERVER uses to reach LiveKit (default: LIVEKIT_URL with ws->http).
# Set it when both run on one machine, e.g. http://livekit:7880
LIVEKIT_API_URL=

# Sign-in cookie. The cookie is marked Secure automatically when the request arrived over https
# (your reverse proxy must send X-Forwarded-Proto: https). Set COOKIE_SECURE=1 to force it.
COOKIE_SECURE=

# Embedding: sites that may show Kabmeet in an iframe (space separated origins, no path).
# If the variable is not set at all, the default is https://ai.kab.ac.ug. Set it blank to forbid all embedding.
# See docs/DEPLOYMENT.md section 4.
EMBED_ORIGINS=https://ai.kab.ac.ug
# Only if Kabmeet runs on a different registrable domain than the site that embeds it
# (for example kabmeet.example.com inside ai.kab.ac.ug). Leave empty when both are under kab.ac.ug.
COOKIE_SAMESITE=

# Phone alerts (Web Push, Task 13). Leave blank to keep push off; the in-app bell works either way.
# Make keys once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ai@kab.ac.ug
