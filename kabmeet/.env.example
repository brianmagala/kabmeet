# Kabmeet Environment Variables Example
# Copy to .env for local development. Never commit .env.

NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
REALTIME_BASE_URL=http://localhost:4100

# Database & Cache
DATABASE_URL=postgresql://kabmeet:change_me_local_dev@localhost:5432/kabmeet
REDIS_URL=redis://localhost:6379

# Auth & Sessions
SESSION_SECRET=replace_with_32_char_random_secret
KABMEET_SEED_PASSWORD=

# LiveKit Self-Hosted Video
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace_with_livekit_secret

# MinIO Object Storage (Recordings)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace_with_minio_secret
MINIO_BUCKET=kabmeet-recordings
